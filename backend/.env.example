# Copia este archivo como backend/.env y completa los valores. NO subas .env al repositorio.

# Puerto de la API. La app Flutter apunta a :3000 por defecto (lib/utils/config.dart).
# Si lo cambias, ejecuta Flutter con --dart-define=API_BASE_URL=http://localhost:<puerto>
PORT=3000

# MySQL (puerto del servidor de base de datos, distinto del de la API)
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=sihaychamba
DB_USER=root
DB_PASSWORD=

# Clave de la Junta (cabecera X-Admin-Key). Mínimo 32 caracteres aleatorios. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Orígenes de Flutter Web permitidos (separados por comas)
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
