# Conexión MySQL referenciada por el usuario.
# Se utiliza servicio_chamba porque fue el esquema SQL más reciente que compartiste.
# Estos valores identifican el destino; NO prueban que el servidor sea accesible.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=sihaychamba
DB_USER=tc_backend
# Sustituir ÚNICAMENTE en backend/.env por la contraseña real (NO compartir).
DB_PASSWORD='TcBackend#Cambiar2026!'

# Configuración de administración solo para entorno de desarrollo.
# Mejor crear y usar cuentas con privilegios mínimos antes de desplegar.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=root
ADMIN_API_KEY=GENERAR_UN_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# MODO DE PRUEBA SIN LOGIN EXTERNO.
# No se configura AUTH_VALIDATE_URL: se ha retirado la autenticación externa.
# La Junta sigue requiriendo ADMIN_API_KEY con al menos 32 caracteres.
